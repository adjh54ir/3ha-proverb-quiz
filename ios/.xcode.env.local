# nvm default alias를 따라간다 — nvm으로 node 업그레이드해도 경로가 안 깨진다.
# nvm 없는 맥(brew)은 아래 경로 중 존재하는 node로 폴백.
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" --no-use && NODE_BINARY="$(nvm which default 2>/dev/null)"
for n in "$NODE_BINARY" /opt/homebrew/bin/node /opt/homebrew/opt/node*/bin/node /usr/local/bin/node; do
  [ -x "$n" ] && export NODE_BINARY="$n" && break
done
export NODE_ARGS="--max-old-space-size=8192"
